{
  "name": "dajare-sencho-kokugo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && node scripts/build-font.mjs && vite",
    "build": "node scripts/generate-icons.mjs && node scripts/build-font.mjs && tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "preview:e2e": "vite preview --host 127.0.0.1",
    "assets": "node scripts/generate-icons.mjs && node scripts/build-font.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "assets:font": "node scripts/build-font.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/generate-icons.mjs && node scripts/build-font.mjs && tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && playwright test",
    "e2e:ui": "node scripts/generate-icons.mjs && node scripts/build-font.mjs && tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && playwright test --ui"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.10.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "fontkit": "^2.0.4",
    "globals": "^17.0.0",
    "prettier": "3.9.6",
    "subset-font": "2.5.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-window": "7.4.1"
  }
}
